# ----------------------------------------------------------------------
# Campus Unlock — Environment Variables (example)
# Copy this file to .env and fill in real values. Never commit .env.
# ----------------------------------------------------------------------

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-key

# Database (SQLite by default; override with a full URL for Postgres/MySQL)
SQLITE_DB_NAME=Campus_Unlock.db
DATABASE_URL=

# Testing database (used only under TestingConfig)
TEST_DATABASE_URL=sqlite:///:memory:

# File Uploads
UPLOAD_FOLDER=static/images/uploads
MAX_CONTENT_LENGTH=5242880

# Logging
LOG_FOLDER=logs
LOG_LEVEL=INFO
